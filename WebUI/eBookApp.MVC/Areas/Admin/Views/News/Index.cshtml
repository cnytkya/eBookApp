@model IEnumerable<News>

@{
    ViewData["Title"] = "News";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="text-primary">News</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Create New
        </a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-lg border-0">
                    <img src="/Images/news/@item.Image" class="card-img-top" alt="No Image Available" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title text-dark">@item.Title</h5>
                        <p class="card-text text-muted">@item.Description</p>
                        <p class="small text-secondary">
                            <i class="far fa-calendar-alt"></i> @item.CreatedDate.ToShortDateString()
                        </p>
                        <div class="d-flex justify-content-between">
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                            <div>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">
                                    <i class="fas fa-info-circle"></i> Details
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
