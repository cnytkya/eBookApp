@model IEnumerable<Contact>

@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid mt-4">
    <div class="mx-auto" style="max-width: 1800px;">
        <div class="bg-light shadow-lg p-4 rounded">
            <h1 class="text-center mb-4 text-primary">Contact List</h1>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0 text-secondary">Contacts</h4>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Create New
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.SurName)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.Phone)</th>
                            <th>@Html.DisplayNameFor(model => model.CreatedDate)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.SurName)</td>
                                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                                <td>@item.CreatedDate.ToShortDateString()</td>
                                <td class="text-center">
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" title="Delete">
                                        <i class="fas fa-trash"></i> <span class="d-none d-md-inline">Delete</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
