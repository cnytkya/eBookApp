@model IEnumerable<Slider>

@{
    ViewData["Title"] = "Slider List";
}
<head>
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css">

    <!-- jQuery ve DataTables JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
</head>

<div class="container-fluid mt-4" style="padding-left: 2px; padding-right: 2px;">
    <div class="row justify-content-between">
        <div class="col-md-9">
            <h1 class="text-primary">Slider List</h1>
        </div>
        <div class="col-md-3 text-end">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus-circle"></i> Create New
            </a>
        </div>
    </div>

    <!-- Table Container with Shadow and Border -->
    <div class="card mt-4 shadow-lg border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table id="sliderTable" class="table table-striped table-bordered table-hover w-100">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Image)</th>
                            <th>@Html.DisplayNameFor(model => model.Title)</th>
                            <th>@Html.DisplayNameFor(model => model.Description)</th>
                            <th>@Html.DisplayNameFor(model => model.Link)</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <a href="/Images/sliders/@item.Image">
                                            <img src="/images/sliders/@item.Image" alt="@item.Title" class="img-fluid" width="100" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No Image</span>
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                                <td>@Html.DisplayFor(modelItem => item.Link)</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Initialize DataTable -->
<script>
    $(document).ready(function () {
        $('#sliderTable').DataTable({
            "paging": true,       // Sayfalama özelliği aktif
            "ordering": true,     // Sıralama özelliği aktif
            "searching": true,    // Arama özelliği aktif
            "lengthMenu": [10, 25, 50, 100], // Sayfa başına gösterilecek veri miktarı
            "language": {
                "lengthMenu": "Göster: _MENU_",
                "zeroRecords": "Kayıt bulunamadı",
                "info": "Toplam _TOTAL_ kayıttan _START_ ile _END_ arası gösteriliyor",
                "infoEmpty": "Veri bulunamadı",
                "search": "Ara:"
            }
        });
    });
</script>
