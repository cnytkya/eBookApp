@model IEnumerable<AppUser>

@{
    ViewData["Title"] = "Users";
}

<div class="container-fluid px-lg-5">
    <div class="card shadow-lg border rounded-lg mt-4">
        <div class="card-header bg-primary text-white py-3">
            <div class="row align-items-center justify-content-center">
                <div class="col-12 col-md-6">   
                    <h3 class="mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="col col-md-6 text-end">
                    <a asp-action="Create" class="btn btn-success">
                        <i class="fas fa-user-plus"></i>
                        <span class="d-none d-md-inline">Add New User</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Sur Name</th>
                            <th>Email</th>
                            <th>Created Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var user in Model)
                        {
                            <tr>
                                <td>@user.Name</td>
                                <td>@user.SurName</td>
                                <td>@user.Email</td>
                                <td>@user.CreatedDate</td>
                                <td>
                                    @if(user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Passive</span>
                                    }

                                    @if (user.IsAdmin)
                                    {
                                        <span class="badge bg-warning text-dark mt-1 d-block d-md-inline">Admin</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-action="Update" class="btn btn-sm btn-primary" title="Update">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" class="btn btn-sm btn-info" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" class="btn btn-sm btn-danger" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-light ">
                <div class="row">
                    <p>Total Users: @Model.Count()</p>
                </div>
            </div>
        </div>
    </div>
</div>
