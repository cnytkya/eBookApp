@model IEnumerable<Category>

<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle text-dark" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        Categories
    </a>
    <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
        @foreach (var mainCategory in Model.Where(c => c.IsActive && c.IsTopMenu && c.ParentId == 0))
        {
            <li>
                <a class="dropdown-item" asp-area="Customer" asp-controller="#" asp-action="#">@mainCategory.Name</a>
            </li>
        }
    </ul>
</li>
